{
  "name": "finkit",
  "version": "0.1.0",
  "description": "Zero-dependency, type-safe financial math for TypeScript: time value of money, loan amortization, interest-rate conversions.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "finance",
    "financial",
    "tvm",
    "time-value-of-money",
    "loan",
    "amortization",
    "interest",
    "npv",
    "irr",
    "pmt",
    "annuity",
    "mortgage",
    "typescript"
  ],
  "license": "MIT",
  "sideEffectsNote": "pure functions only",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
