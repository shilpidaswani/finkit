{
  "name": "finlytic",
  "version": "0.2.0",
  "description": "Zero-dependency, type-safe financial math for TypeScript: time value of money, loan amortization, bond analytics, depreciation, dated cash flows, and more.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "finance",
    "financial",
    "tvm",
    "time-value-of-money",
    "loan",
    "amortization",
    "interest",
    "npv",
    "irr",
    "xirr",
    "xnpv",
    "pmt",
    "annuity",
    "mortgage",
    "bond",
    "duration",
    "convexity",
    "yield-to-maturity",
    "depreciation",
    "day-count",
    "mirr",
    "cagr",
    "typescript"
  ],
  "license": "MIT",
  "author": "Shilpi Daswani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shilpidaswani/finkit.git"
  },
  "homepage": "https://github.com/shilpidaswani/finkit#readme",
  "bugs": {
    "url": "https://github.com/shilpidaswani/finkit/issues"
  },
  "sideEffectsNote": "pure functions only",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
